rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Patient report uploads ──────────────────────────────
    match /reports/{patientId}/{fileName} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null
                    && request.auth.uid == patientId
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('(application/pdf|image/(jpeg|jpg|png))');
      allow delete: if request.auth != null && request.auth.uid == patientId;
    }

    // ── Prescription scans ──────────────────────────────────
    match /prescriptions/{patientId}/{fileName} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('(application/pdf|image/(jpeg|jpg|png))');
      allow delete: if request.auth != null;
    }

    // ── Avatars ─────────────────────────────────────────────
    match /avatars/{userId}/{fileName} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
